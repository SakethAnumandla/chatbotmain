# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-oss:120b
OPENAI_BASE_URL=https://ollama.com/v1/

# Platform API Configuration
PLATFORM_API_BASE_URL=https://your-platform-api.com/api/v1
PLATFORM_API_KEY=your_platform_api_key_here
PLATFORM_API_TIMEOUT=30

# Session Configuration
SESSION_TTL=3600  # Session timeout in seconds (1 hour)

# Application Configuration
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=5000
APP_SECRET_KEY=your_secret_key_here_change_in_production

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=20
